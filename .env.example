# --- Local dev only (never used for Track 1 submission answers) ---
ALLOW_LOCAL_DEV=1
LOCAL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/api/generate
LOCAL_MODEL_NAME=qwen2.5:0.5b

# AMD GPU notebook / vLLM (dev routing experiments only)
# LOCAL_PROVIDER=openai_compatible
# LOCAL_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8001/v1/chat/completions

# --- Fireworks (injected by hackathon harness in production) ---
FIREWORKS_API_KEY=your_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/chat/completions

# Comma-separated allow-list — required at runtime (no hardcoded model IDs in code)
ALLOWED_MODELS=accounts/fireworks/models/minimax-m3,accounts/fireworks/models/kimi-k2p7-code,accounts/fireworks/models/gemma-4-31b-it,accounts/fireworks/models/gemma-4-26b-a4b-it

# Dev mock when Fireworks is unavailable
ALLOW_DEV_MOCK=0

# Semantic router (local embeddings, not scored inference)
ENABLE_SEMANTIC_ROUTER=true
SEMANTIC_ROUTER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_ROUTER_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_ROUTER_THRESHOLD=0.42